# Copy to .env.local and fill in real values. Never commit .env.local.

# Used only by local image-fetch scripts (not required for the live site).
PEXELS_API_KEY=your_pexels_api_key_here

# Optional site URL override
# NEXT_PUBLIC_SITE_URL=https://www.randomanimalgenerator.online

# Server-only secrets for IndexNow cron / manual API auth (set on Vercel if used)
# INDEXNOW_SECRET=
# CRON_SECRET=
